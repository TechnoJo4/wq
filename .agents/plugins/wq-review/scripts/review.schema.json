{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "changes_requested", "invalid_request"]
    },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocking", "non_blocking"]
          },
          "requirement_ids": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "location": { "type": "string" },
          "problem": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "required": ["severity", "requirement_ids", "location", "problem", "evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["verdict", "summary", "findings"],
  "additionalProperties": false
}
